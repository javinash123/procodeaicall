# ============================================================
# NIJVOX — Production Environment Variables
# Copy this file to your EC2 server as:  /home/ec2-user/nijvox/.env
# Then edit every value marked with  ← REQUIRED
# ============================================================

# Node environment (do not change)
NODE_ENV=production

# Port the Node.js server listens on (nginx proxies to this)
PORT=5000

# ---- Database -----------------------------------------------
# MongoDB Atlas connection string  ← REQUIRED
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/nijvox?retryWrites=true&w=majority

# ---- Session ------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING    # ← REQUIRED

# ---- Cookie / Proxy -----------------------------------------
# Set to "true" when running behind HTTPS nginx (recommended).
# Set to "false" only during initial setup before SSL is configured.
COOKIE_SECURE=true

# ---- OpenAI -------------------------------------------------
OPENAI_API_KEY=sk-...    # ← REQUIRED

# ---- Razorpay -----------------------------------------------
# RAZORPAY_KEY_ID is the PUBLIC key (starts with rzp_live_ or rzp_test_).
# This replaces the old VITE_RAZORPAY_KEY_ID build-time variable.
# The app now fetches it at runtime — no rebuild needed when you change it.
RAZORPAY_KEY_ID=rzp_live_...       # ← REQUIRED for payments
RAZORPAY_KEY_SECRET=...            # ← REQUIRED for payments

# ---- Exotel (AI Calling) ------------------------------------
# Only needed if you use the AI calling campaign feature
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=

# ---- Twilio SMS (optional) ----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
